<?xml version="1.0"?>
<sdf version="1.7">
  <model name="victim">
    <static>true</static>
    <!-- ~1.8 m standing figure, origin at the feet, facing +X.
         Right arm raised and raked forward = waving. Hi-viz orange torso +
         white hard hat use strong <emissive> so the person reads clearly in
         drone-camera footage regardless of how the nook is lit, and gives an
         honest colour target for the Step-5 detector. -->
    <link name="body">

      <visual name="leg_l">
        <pose>0 0.12 0.42 0 0 0</pose>
        <geometry><box><size>0.18 0.16 0.84</size></box></geometry>
        <material><ambient>0.06 0.07 0.14 1</ambient><diffuse>0.13 0.15 0.30 1</diffuse></material>
      </visual>
      <visual name="leg_r">
        <pose>0 -0.12 0.42 0 0 0</pose>
        <geometry><box><size>0.18 0.16 0.84</size></box></geometry>
        <material><ambient>0.06 0.07 0.14 1</ambient><diffuse>0.13 0.15 0.30 1</diffuse></material>
      </visual>

      <visual name="pelvis">
        <pose>0 0 0.96 0 0 0</pose>
        <geometry><box><size>0.28 0.36 0.24</size></box></geometry>
        <material>
          <ambient>0.9 0.4 0.05 1</ambient><diffuse>1.0 0.45 0.05 1</diffuse>
          <emissive>0.55 0.22 0.02 1</emissive>
        </material>
      </visual>
      <visual name="torso">
        <pose>0 0 1.36 0 0 0</pose>
        <geometry><box><size>0.26 0.42 0.60</size></box></geometry>
        <material>
          <ambient>1.0 0.45 0.05 1</ambient><diffuse>1.0 0.5 0.08 1</diffuse>
          <emissive>0.7 0.30 0.03 1</emissive>
        </material>
      </visual>
      <!-- reflective band -->
      <visual name="hiviz_band">
        <pose>0.001 0 1.20 0 0 0</pose>
        <geometry><box><size>0.27 0.43 0.10</size></box></geometry>
        <material>
          <ambient>0.9 0.9 0.85 1</ambient><diffuse>0.95 0.95 0.9 1</diffuse>
          <emissive>0.8 0.8 0.75 1</emissive>
        </material>
      </visual>

      <visual name="neck">
        <pose>0 0 1.70 0 0 0</pose>
        <geometry><box><size>0.10 0.12 0.10</size></box></geometry>
        <material><ambient>0.55 0.4 0.3 1</ambient><diffuse>0.82 0.62 0.48 1</diffuse>
          <emissive>0.3 0.22 0.16 1</emissive></material>
      </visual>
      <visual name="head">
        <pose>0 0 1.84 0 0 0</pose>
        <geometry><box><size>0.17 0.16 0.20</size></box></geometry>
        <material><ambient>0.55 0.4 0.3 1</ambient><diffuse>0.82 0.62 0.48 1</diffuse>
          <emissive>0.32 0.24 0.18 1</emissive></material>
      </visual>
      <!-- white hard hat -->
      <visual name="hardhat">
        <pose>-0.01 0 1.97 0 0 0</pose>
        <geometry><box><size>0.20 0.19 0.10</size></box></geometry>
        <material>
          <ambient>0.95 0.95 0.95 1</ambient><diffuse>1.0 1.0 1.0 1</diffuse>
          <emissive>0.75 0.75 0.75 1</emissive>
        </material>
      </visual>

      <visual name="arm_l">
        <pose>0 0.30 1.28 0 0 0</pose>
        <geometry><box><size>0.12 0.12 0.60</size></box></geometry>
        <material><ambient>0.9 0.4 0.05 1</ambient><diffuse>0.95 0.42 0.06 1</diffuse>
          <emissive>0.55 0.22 0.02 1</emissive></material>
      </visual>
      <visual name="hand_l">
        <pose>0 0.30 0.95 0 0 0</pose>
        <geometry><box><size>0.10 0.10 0.12</size></box></geometry>
        <material><ambient>0.55 0.4 0.3 1</ambient><diffuse>0.82 0.62 0.48 1</diffuse>
          <emissive>0.3 0.22 0.16 1</emissive></material>
      </visual>

      <visual name="arm_r_upper">
        <pose>0.10 -0.32 1.60 0 -0.9 0</pose>
        <geometry><box><size>0.12 0.12 0.42</size></box></geometry>
        <material><ambient>0.9 0.4 0.05 1</ambient><diffuse>0.95 0.42 0.06 1</diffuse>
          <emissive>0.55 0.22 0.02 1</emissive></material>
      </visual>
      <visual name="arm_r_fore">
        <pose>0.30 -0.34 1.92 0 -0.35 0</pose>
        <geometry><box><size>0.11 0.11 0.44</size></box></geometry>
        <material><ambient>0.55 0.4 0.3 1</ambient><diffuse>0.82 0.62 0.48 1</diffuse>
          <emissive>0.32 0.24 0.18 1</emissive></material>
      </visual>
      <visual name="hand_r">
        <pose>0.42 -0.35 2.12 0 0 0</pose>
        <geometry><box><size>0.13 0.13 0.15</size></box></geometry>
        <material><ambient>0.6 0.44 0.33 1</ambient><diffuse>0.86 0.66 0.5 1</diffuse>
          <emissive>0.34 0.26 0.2 1</emissive></material>
      </visual>

    </link>
  </model>
</sdf>
