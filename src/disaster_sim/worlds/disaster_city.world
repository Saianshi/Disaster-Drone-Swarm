<?xml version="1.0"?>
<sdf version="1.7">
  <world name="disaster_city">

    <!-- kinematic pose control for the drones (mission node -> /gazebo/set_entity_state) -->
    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <ros><namespace>/gazebo</namespace></ros>
      <update_rate>60.0</update_rate>
    </plugin>

    <!-- ================= physics / scene ================= -->
    <physics name="ode_default" type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_update_rate>250</real_time_update_rate>
      <real_time_factor>1</real_time_factor>
    </physics>

    <!-- start the Gazebo window looking at the whole action: the 5G van +
         drones (x~125) in the foreground, the damaged building (x~46) and the
         city behind. Default camera looks at the origin and the drones would
         be off-screen. -->
    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>150 -62 42 0 0.42 2.35</pose>
        <view_controller>orbit</view_controller>
        <projection_type>perspective</projection_type>
      </camera>
    </gui>

    <scene>
      <ambient>0.55 0.55 0.58 1</ambient>
      <background>0.74 0.82 0.92 1</background>
      <shadows>true</shadows>
      <grid>false</grid>
      <origin_visual>false</origin_visual>
    </scene>

    <!-- ================= lighting =================
         default Gazebo has one flat directional light. This adds a warm key
         with shadows, a cool sky fill, and a spot washing the damaged facade
         so camera footage has depth and the building reads on video. -->
    <light name="key_sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 60 0 0 0</pose>
      <diffuse>1.05 0.99 0.89 1</diffuse>
      <specular>0.35 0.33 0.29 1</specular>
      <direction>-0.35 0.42 -0.84</direction>
      <attenuation>
        <range>1000</range>
        <constant>0.85</constant>
        <linear>0.005</linear>
        <quadratic>0.0</quadratic>
      </attenuation>
    </light>

    <light name="sky_fill" type="directional">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 50 0 0 0</pose>
      <diffuse>0.40 0.40 0.42 1</diffuse>
      <specular>0.04 0.04 0.05 1</specular>
      <direction>0.55 -0.35 -0.75</direction>
    </light>

    <!-- spot washing the EAST facade of the damaged building (the victim
         facade) from the open ground east of it -->
    <light name="facade_spot" type="spot">
      <cast_shadows>false</cast_shadows>
      <pose>66 0 16 0 0 3.1416</pose>
      <diffuse>0.45 0.43 0.38 1</diffuse>
      <specular>0.1 0.1 0.09 1</specular>
      <direction>-0.80 0 -0.60</direction>
      <spot>
        <inner_angle>0.5</inner_angle>
        <outer_angle>0.95</outer_angle>
        <falloff>1.4</falloff>
      </spot>
      <attenuation>
        <range>70</range>
        <constant>0.6</constant>
        <linear>0.02</linear>
        <quadratic>0.0</quadratic>
      </attenuation>
    </light>

    <!-- soft warm fill over the building so it is not a dark mass -->
    <light name="building_fill" type="point">
      <cast_shadows>false</cast_shadows>
      <pose>48 0 22 0 0 0</pose>
      <diffuse>0.35 0.33 0.30 1</diffuse>
      <specular>0.03 0.03 0.03 1</specular>
      <attenuation>
        <range>45</range>
        <constant>0.6</constant>
        <linear>0.025</linear>
        <quadratic>0.0</quadratic>
      </attenuation>
    </light>

    <!-- ================= ground datum =================
         disaster_city carries its own ground/road plate whose TOP surface is
         at world Z = 0 (measured). That is the datum. This large plane sits
         5 cm below it so the open ground beyond the city block reads flush
         with no z-fighting. -->
    <model name="terrain">
      <static>true</static>
      <pose>30 0 -0.05 0 0 0</pose>
      <link name="link">
        <collision name="c">
          <geometry><plane><normal>0 0 1</normal><size>600 600</size></plane></geometry>
          <surface><friction><ode><mu>80</mu><mu2>40</mu2></ode></friction></surface>
        </collision>
        <visual name="v">
          <cast_shadows>false</cast_shadows>
          <geometry><plane><normal>0 0 1</normal><size>600 600</size></plane></geometry>
          <material>
            <ambient>0.32 0.31 0.29 1</ambient>
            <diffuse>0.40 0.39 0.36 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ================= the city (anchor, at the origin) ================= -->
    <include>
      <name>disaster_city</name>
      <uri>model://disaster_city</uri>
      <pose>0 0 0 0 0 0</pose>
    </include>

    <!-- ================= earthquake-damaged building =================
         East edge of the city block. City structure ends near x=+36; this
         building spans world x[34.8,58.5] y[-5.9,5.3], sitting on the open
         eastern margin of the city plate against the perimeter street - it
         reads as a block building that came down. Lifted +0.33 so its lowest
         geometry (mesh min-Z -0.33) rests exactly on the datum. Not rotated:
         its carved victim window (mesh local +X) faces east into open ground,
         world window centre ~ (51.7, 0, 7.4). -->
    <include>
      <name>damaged_building</name>
      <uri>model://damaged_building</uri>
      <pose>46 0 0.33 0 0 0</pose>
    </include>

    <!-- ================= 5G command post =================
         ~79 m east of the damaged building on open ground (past the city
         plate edge x=60), clear line of sight west to the victim window.
         Lifted +0.60 so the wheels (mesh min-Z -0.60) rest on the datum. -->
    <include>
      <name>fiveg_base_station</name>
      <uri>model://fiveg_base_station</uri>
      <pose>125 -8 0.60 0 0 3.05</pose>
    </include>

    <!-- ================= the victim =================
         2nd floor of the damaged building, inside the carved east window.
         victim_nook shares the building's pose (46 0 0.33); its boxes are in
         building-local coords so they track the building. Baffles + lintel
         keep the victim visible only from roughly due-east at window height.
         World window centre ~ (51.7, 0, 7.4). -->
    <model name="victim_nook">
      <static>true</static>
      <pose>46 0 0.33 0 0 0</pose>
      <link name="body">
        <visual name="slab">
          <pose>4.6 0.0 5.94 0 0 0</pose>
          <geometry><box><size>2.8 3.6 0.15</size></box></geometry>
          <material><ambient>0.22 0.22 0.24 1</ambient><diffuse>0.32 0.32 0.34 1</diffuse></material>
        </visual>
        <visual name="baffle_n">
          <pose>5.0 0.5 7.36 0 0 0</pose>
          <geometry><box><size>2.0 0.12 3.1</size></box></geometry>
          <material><ambient>0.15 0.14 0.13 1</ambient><diffuse>0.23 0.21 0.19 1</diffuse></material>
        </visual>
        <visual name="baffle_s">
          <pose>5.0 -0.5 7.36 0 0 0</pose>
          <geometry><box><size>2.0 0.12 3.1</size></box></geometry>
          <material><ambient>0.15 0.14 0.13 1</ambient><diffuse>0.23 0.21 0.19 1</diffuse></material>
        </visual>
        <visual name="baffle_back">
          <pose>4.05 0.0 7.36 0 0 0</pose>
          <geometry><box><size>0.12 1.3 3.1</size></box></geometry>
          <material><ambient>0.15 0.14 0.13 1</ambient><diffuse>0.23 0.21 0.19 1</diffuse></material>
        </visual>
        <visual name="baffle_top">
          <pose>5.0 0.0 8.41 0 0 0</pose>
          <geometry><box><size>2.0 1.3 0.2</size></box></geometry>
          <material><ambient>0.15 0.14 0.13 1</ambient><diffuse>0.23 0.21 0.19 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- box-figure person on the deck, inside the opening, facing east (+X)
         out the window, right arm raised. World pose = building pose +
         local (5.05, 0, 6.01). -->
    <include>
      <name>victim</name>
      <uri>model://victim</uri>
      <pose>51.05 0.0 6.34 0 0 0</pose>
    </include>

  </world>
</sdf>
